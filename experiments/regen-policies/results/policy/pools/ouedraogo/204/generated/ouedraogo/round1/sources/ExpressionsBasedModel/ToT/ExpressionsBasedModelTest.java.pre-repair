    /** Test that the model's isAnyConstraintQuadratic returns false when no constraints are quadratic. */
    @Test
    public void testConstraintQuadraticWhenNone() {
        Variable x = model.addVariable("x");
        Expression expr = model.addExpression("c");
        expr.add(x, BigDecimal.ONE);
        expr.upper(BigDecimal.TEN);
        assertFalse(model.isAnyConstraintQuadratic());
    }

    /** Test that the model's isAnyExpressionQuadratic returns true when a quadratic expression is present even if not a constraint. */
    @Test
    public void testExpressionQuadraticWhenNotConstraint() {
        Variable x = model.addVariable("x");
        Variable y = model.addVariable("y");
        Expression expr = model.addExpression("obj");
        expr.weight(BigDecimal.ONE);
        expr.add(x, y, BigDecimal.ONE); // quadratic term, marked as objective
        assertTrue(model.isAnyExpressionQuadratic());
    }

    /** Test that the model's isAnyExpressionQuadratic returns false for purely linear model. */
    @Test
    public void testExpressionQuadraticLinearModel() {
        Variable x = model.addVariable("x");
        Expression expr = model.addExpression("lin");
        expr.add(x, BigDecimal.ONE);
        assertFalse(model.isAnyExpressionQuadratic());
    }

    /** Test that the model's isAnyObjectiveQuadratic returns false when objective has no quadratic term. */
    @Test
    public void testObjectiveQuadraticFalse() {
        Variable x = model.addVariable("x").weight(BigDecimal.ONE);
        assertFalse(model.isAnyObjectiveQuadratic());
    }

    /** Test that the model's isAnyObjectiveQuadratic returns true when objective contains quadratic term. */
    @Test
    public void testObjectiveQuadraticTrue() {
        Variable x = model.addVariable("x");
        Variable y = model.addVariable("y");
        Expression obj = model.addExpression("obj");
        obj.weight(BigDecimal.ONE);
        obj.add(x, y, BigDecimal.ONE);
        assertTrue(model.isAnyObjectiveQuadratic());
    }

    /** Test that the model's isAnyConstraintQuadratic returns true when a quadratic constraint is added. */
    @Test
    public void testConstraintQuadraticTrue() {
        Variable x = model.addVariable("x");
        Variable y = model.addVariable("y");
        Expression c = model.addExpression("c");
        c.add(x, y, BigDecimal.ONE);
        c.upper(BigDecimal.TEN);
        assertTrue(model.isAnyConstraintQuadratic());
    }

    /** Test that the model's isAnyVariableFixed returns false when no variable is fixed. */
    @Test
    public void testAnyVariableFixedFalse() {
        model.addVariable("a");
        model.addVariable("b");
        assertFalse(model.isAnyVariableFixed());
    }

    /** Test that the model's getVariableValues returns APPROXIMATE when solution validation fails. */
    @Test
    public void testVariableValuesApproximateState() {
        // create a variable with a narrow feasible interval
        Variable v = model.addVariable("v").lower(BigDecimal.valueOf(0)).upper(BigDecimal.valueOf(1));
        // manually set a value that violates the feasibility tolerance
        v.setValue(BigDecimal.valueOf(2));
        Optimisation.Result result = model.getVariableValues();
        assertEquals(Optimisation.State.APPROXIMATE, result.getState());
    }

    /** Test that the model's isAnyVariableFixed returns true when a variable has a fixed value via lower=upper. */
    @Test
    public void testVariableFixedViaEqualityConstraint() {
        Variable v = model.addVariable("v").lower(BigDecimal.valueOf(3)).upper(BigDecimal.valueOf(3));
        assertTrue(v.isEqualityConstraint());
        assertTrue(model.isAnyVariableFixed());
    }

    /** Test that the model's isAnyVariableInteger returns false when model is relaxed. */
    @Test
    public void testIntegerDetectionWhenRelaxed() {
        model.addVariable("intVar").integer();
        model.relax();
        assertFalse(model.isAnyVariableInteger());
    }

    /** Test that the model's isAnyVariableInteger returns false after all integer variables are fixed, even when not relaxed. */
    @Test
    public void testIntegerDetectionAllFixed() {
        model.addVariable("intVar").integer().value(BigDecimal.ONE);
        assertFalse(model.isAnyVariableInteger());
    }

    /** Test that the model's isAnyVariableInteger returns true when at least one integer variable is free, regardless of other fixed integer variables. */
    @Test
    public void testIntegerDetectionMixed() {
        model.addVariable("intVar1").integer(); // free
        model.addVariable("intVar2").integer().value(BigDecimal.ONE); // fixed
        assertTrue(model.isAnyVariableInteger());
    }

    /** Test that the model's isAnyVariableInteger returns false after calling hard relax on a model that originally had integer variables. */
    @Test
    public void testHardRelaxClearsIntegerFlag() {
        model.addVariable("intVar").integer();
        model.relax(); // hard relax
        assertFalse(model.isAnyVariableInteger());
    }

    /** Test that the model's isAnyVariableInteger returns true after soft relax, keeping integer flag. */
    @Test
    public void testSoftRelaxKeepsIntegerFlag() {
        model.addVariable("intVar").integer();
        model.relax(true); // soft relax
        assertTrue(model.isAnyVariableInteger());
        assertTrue(model.isRelaxed());
    }

    /** Test that the model's isAnyVariableInteger returns false after hard relaxation even if integer variables were previously added. */
    @Test
    public void testHardRelaxAfterIntegerVariables() {
        model.addVariable("intVar").integer();
        model.relax(); // hard relax
        assertFalse(model.isAnyVariableInteger());
    }

    /** Test that the model's isAnyVariableInteger returns false after all integer variables are fixed, even after soft relaxation. */
    @Test
    public void testSoftRelaxAllIntegersFixed() {
        model.addVariable("intVar").integer().value(BigDecimal.ONE);
        model.relax(true); // soft relax
        assertFalse(model.isAnyVariableInteger());
    }

    /** Test that the model's isAnyVariableInteger returns true after adding a free integer variable, even after soft relaxation. */
    @Test
    public void testSoftRelaxWithFreeInteger() {
        model.addVariable("intVar").integer();
        model.relax(true); // soft relax
        assertTrue(model.isAnyVariableInteger());
    }

    /** Test that the model's isAnyVariableInteger returns false after calling hard relaxation, even if integer variables exist. */
    @Test
    public void testHardRelaxDisablesIntegerDetection() {
        model.addVariable("intVar").integer();
        model.relax(); // hard relax
        assertFalse(model.isAnyVariableInteger());
    }

    /** Test that the model's isAnyVariableInteger returns true after adding an integer variable, before any relaxation. */
    @Test
    public void testIntegerDetectionBeforeRelaxation() {
        model.addVariable("intVar").integer();
        assertTrue(model.isAnyVariableInteger());
    }

    /** Test that the model's isAnyVariableInteger returns false when the model has no variables at all. */
    @Test
    public void testIntegerDetectionNoVariables() {
        assertFalse(model.isAnyVariableInteger());
    }

    /** Test that the model's isAnyVariableInteger returns false when all variables are binary (binary is a subclass of integer). */
    @Test
    public void testBinaryVariablesAreInteger() {
        model.addVariable("b1").binary();
        model.addVariable("b2").binary();
        // binary variables are also integer, so detection should be true
        assertTrue(model.isAnyVariableInteger());
    }

    /** Test that the model's isAnyVariableInteger returns false after converting binary variables to non‑integer via relax(). */
    @Test
    public void testRelaxBinaryVariables() {
        model.addVariable("b").binary();
        model.relax();
        assertFalse(model.isAnyVariableInteger());
    }

    /** Test that the model's isAnyVariableInteger returns true after adding a binary variable, before relaxation. */
    @Test
    public void testBinaryVariableIntegerDetection() {
        model.addVariable("b").binary();
        assertTrue(model.isAnyVariableInteger());
    }

    /** Test that the model's isAnyVariableInteger returns false after soft relaxation of binary variables. */
    @Test
    public void testSoftRelaxBinaryVariables() {
        model.addVariable("b").binary();
        model.relax(true);
        assertTrue(model.isAnyVariableInteger()); // soft relaxation keeps integer flag
    }

    /** Test that the model's isAnyVariableInteger returns false after hard relaxation of binary variables. */
    @Test
    public void testHardRelaxBinaryVariables() {
        model.addVariable("b").binary();
        model.relax();
        assertFalse(model.isAnyVariableInteger());
    }
}
