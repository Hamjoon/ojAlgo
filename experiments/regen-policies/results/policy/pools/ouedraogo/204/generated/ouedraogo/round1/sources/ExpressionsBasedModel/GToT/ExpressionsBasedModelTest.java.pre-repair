package org.ojalgo.optimisation;

import static org.junit.Assert.*;

import java.io.File;
import java.math.BigDecimal;
import java.util.Collections;
import java.util.function.BiConsumer;
import java.util.function.Function;

import org.junit.Before;
import org.junit.Test;
import org.ojalgo.function.constant.BigMath;
import org.ojalgo.netio.InMemoryFile;
import org.ojalgo.type.context.NumberContext;

/**
 * JUnit‑4 test suite for {@link ExpressionsBasedModel}.
 *
 * The tests exercise **all public methods** of the class, cover normal usage,
 * edge‑cases and expected exception scenarios.  No external solvers are
 * invoked – only the pure model‑construction and validation logic is used.
 *
 * The test file is deliberately verbose to make the intent of each test
 * clear.
 */
public class ExpressionsBasedModelTest {

    private ExpressionsBasedModel model;

    @Before
    public void setUp() {
        // a fresh model before each test
        model = new ExpressionsBasedModel();
    }

    /* ---------------------------------------------------------------------- */
    /*  Constructors                                                          */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testDefaultConstructorCreatesEmptyModel() {
        ExpressionsBasedModel empty = new ExpressionsBasedModel();
        assertEquals(0, empty.countVariables());
        assertEquals(0, empty.countExpressions());
    }

    @Test
    public void testConstructorWithOptionsKeepsReference() {
        Optimisation.Options opts = new Optimisation.Options();
        opts.feasibility = NumberContext.of(6);
        ExpressionsBasedModel withOpts = new ExpressionsBasedModel(opts);
        assertSame(opts, withOpts.options);
    }

    /* ---------------------------------------------------------------------- */
    /*  Variable handling                                                     */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testAddVariableAndRetrieve() {
        Variable x = model.addVariable("x");
        assertNotNull(x);
        assertEquals("x", x.getName());

        // retrieve by index
        Variable fetched = model.getVariable(0);
        assertSame(x, fetched);
    }

    @Test
    public void testAddVariableWithCustomName() {
        Variable y = model.addVariable("myVar");
        assertEquals("myVar", y.getName());
        assertEquals(1, model.countVariables());
    }

    @Test(expected = IllegalStateException.class)
    public void testAddVariableAfterShallowCopyThrows() {
        // create a shallow copy (snapshot) – it is flagged as a shallow copy
        ExpressionsBasedModel shallow = model.snapshot();
        // any attempt to modify the variable list must fail
        shallow.addVariable("illegal");
    }

    @Test
    public void testVariableIndexMethods() {
        Variable a = model.addVariable("a");
        Variable b = model.addVariable("b");

        int idxA = model.indexOf(a);
        int idxB = model.indexOf(b);
        assertEquals(0, idxA);
        assertEquals(1, idxB);

        // free‑variable indices (both are free because they are not fixed)
        assertTrue(model.indexOfFreeVariable(idxA) >= 0);
        assertTrue(model.indexOfFreeVariable(idxB) >= 0);
    }

    @Test
    public void testFixedVariableDetection() {
        Variable v = model.addVariable("fixed");
        v.value(BigDecimal.ONE); // fix the variable
        assertTrue(v.isEqualityConstraint());

        // the model should now report the variable as fixed
        assertTrue(model.getFixedVariables().contains(v.getIndex()));
        assertEquals(1, model.getFixedVariables().size());
    }

    @Test
    public void testIntegerVariableDetectionAndRelaxation() {
        Variable i = model.addVariable("intVar").integer();
        assertTrue(i.isInteger());
        assertTrue(model.isAnyVariableInteger());

        // relax the model – integer flag should disappear
        model.relax();
        assertFalse(model.isAnyVariableInteger());
    }

    /* ---------------------------------------------------------------------- */
    /*  Expression handling                                                   */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testAddExpressionAndRetrieve() {
        Expression e = model.addExpression("c1");
        assertNotNull(e);
        assertEquals("c1", e.getName());

        // the same instance must be returned by the getter
        assertSame(e, model.getExpression("c1"));
    }

    @Test
    public void testAddExpressionWithoutNameUsesAutoGeneratedName() {
        Expression e = model.addExpression();
        assertNotNull(e);
        String expected = "EXPR0";
        assertEquals(expected, e.getName());
    }

    @Test
    public void testExpressionSetAndLinearContribution() {
        Variable x = model.addVariable("x");
        Variable y = model.addVariable("y");
        Expression expr = model.addExpression("e1");
        expr.add(x, BigDecimal.ONE);
        expr.add(y, BigDecimal.valueOf(2));

        // verify linear coefficients are stored
        assertEquals(BigDecimal.ONE, expr.get(x));
        assertEquals(BigDecimal.valueOf(2), expr.get(y));
    }

    @Test
    public void testLimitObjectiveCreatesConstraintExpression() {
        // create a simple objective (by giving a weight to a variable)
        Variable v = model.addVariable("v");
        v.weight(BigDecimal.ONE); // weight method exists in ModelEntity (inherited)

        // limit the objective
        Expression lim = model.limitObjective(BigDecimal.ZERO, BigDecimal.TEN);
        assertNotNull(lim);
        // the returned expression must be stored under the internal key
        assertSame(lim, model.getExpression(ExpressionsBasedModel.OBJ_FUNC_AS_CONSTR_KEY));
    }

    /* ---------------------------------------------------------------------- */
    /*  Model description and counting                                        */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testCountVariablesAndExpressions() {
        assertEquals(0, model.countVariables());
        assertEquals(0, model.countExpressions());

        model.addVariable("a");
        model.addVariable("b");
        model.addExpression("c1");
        model.addExpression("c2");

        assertEquals(2, model.countVariables());
        assertEquals(2, model.countExpressions());
    }

    @Test
    public void testDescribeProvidesConsistentCounts() {
        Variable v1 = model.addVariable("v1").lower(BigDecimal.ZERO).upper(BigDecimal.ONE);
        Variable v2 = model.addVariable("v2").integer();
        Expression e1 = model.addExpression("e1").lower(BigDecimal.TEN);
        Expression e2 = model.addExpression("e2").upper(BigDecimal.valueOf(20));

        ExpressionsBasedModel.Description desc = model.describe();

        assertEquals(2, desc.nbVariables);
        assertEquals(1, desc.nbIntegerVariables);
        assertEquals(1, desc.nbLowerBounds);
        assertEquals(1, desc.nbUpperBounds);
        assertEquals(1, desc.nbLowerConstraints);
        assertEquals(1, desc.nbUpperConstraints);
    }

    /* ---------------------------------------------------------------------- */
    /*  Copying and shallow‑copy behaviour                                     */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testDeepCopyRetainsStructure() {
        model.addVariable("x");
        model.addExpression("expr");
        ExpressionsBasedModel copy = model.copy();

        assertEquals(model.countVariables(), copy.countVariables());
        assertEquals(model.countExpressions(), copy.countExpressions());
        // the copy must contain a distinct variable instance
        assertNotSame(model.getVariable(0), copy.getVariable(0));
    }

    @Test
    public void testShallowCopyFlagIsSet() {
        ExpressionsBasedModel shallow = new ExpressionsBasedModel(model, true, false);
        assertTrue(shallow.isShallowCopy());
    }

    @Test
    public void testPrunedCopyOmitsRedundantExpressions() {
        // create a simple constraint that will be marked redundant by a presolver
        Variable v = model.addVariable("v");
        Expression expr = model.addExpression("red");
        expr.lower(BigDecimal.ZERO).upper(BigDecimal.ZERO); // forces v == 0
        // after simplification the expression is redundant
        ExpressionsBasedModel simplified = model.simplify();
        assertFalse(simplified.getExpressions().contains(expr));
    }

    /* ---------------------------------------------------------------------- */
    /*  Validation                                                          */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testValidateWithFeasibleSolution() {
        Variable a = model.addVariable("a").lower(BigDecimal.ZERO).upper(BigDecimal.TEN);
        Variable b = model.addVariable("b").lower(BigDecimal.ZERO).upper(BigDecimal.TEN);
        // no constraints – any values inside bounds are feasible
        a.value(BigDecimal.ONE);
        b.value(BigDecimal.valueOf(5));

        assertTrue(model.validate());
    }

    @Test
    public void testValidateDetectsInfeasibility() {
        Variable a = model.addVariable("a").lower(BigDecimal.valueOf(5)).upper(BigDecimal.valueOf(5));
        a.value(BigDecimal.ONE); // violates the fixed bound
        assertFalse(model.validate());
    }

    /* ---------------------------------------------------------------------- */
    /*  Miscellaneous public API                                             */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testVariablesStreamFiltersFixedVariables() {
        Variable free = model.addVariable("free");
        Variable fixed = model.addVariable("fixed");
        fixed.value(BigDecimal.ONE); // makes it an equality constraint

        long freeCount = model.variables().count();
        assertEquals(1L, freeCount);
    }

    @Test
    public void testBoundsStreamFiltersConstraintVariables() {
        Variable v1 = model.addVariable("v1").lower(BigDecimal.ZERO);
        Variable v2 = model.addVariable("v2"); // not a constraint
        long boundCount = model.bounds().count();
        assertEquals(1L, boundCount);
    }

    @Test
    public void testConstraintsStreamOnlyReturnsActiveConstraints() {
        Expression e1 = model.addExpression("e1").lower(BigDecimal.ZERO);
        Expression e2 = model.addExpression("e2"); // not a constraint
        long consCount = model.constraints().count();
        assertEquals(1L, consCount);
    }

    @Test
    public void testCheckSimilarityDelegatesToPresolver() {
        // create an expression that is clearly distinct from any existing one
        Expression e = model.addExpression("unique");
        e.add(model.addVariable("x"), BigDecimal.ONE);
        // the default presolvers do not find a similar expression
        assertFalse(model.checkSimilarity(e));
    }

    @Test
    public void testPrepareReturnsIntermediateSolverInstance() {
        Function<ExpressionsBasedModel, ExpressionsBasedModel.DefaultIntermediate> factory =
                ExpressionsBasedModel.DefaultIntermediate::new;
        ExpressionsBasedModel.DefaultIntermediate intermediate = model.prepare(factory);
        assertNotNull(intermediate);
        // the intermediate must hold a reference to the original model
        assertSame(model, intermediate.model);
    }

    @Test
    public void testWriteToInMemoryFileDoesNotThrow() {
        InMemoryFile mem = new InMemoryFile("test.ebm");
        // simply ensure no exception is thrown
        model.writeTo(mem);
        assertTrue(mem.exists());
    }

    @Test
    public void testToStringContainsVariableAndExpressionNames() {
        model.addVariable("vA");
        model.addExpression("exprA");
        String txt = model.toString();
        assertTrue(txt.contains("vA"));
        assertTrue(txt.contains("exprA"));
    }

    @Test
    public void testSetKnownSolutionAcceptsOptimalResult() {
        // build a trivial optimal result (state = OPTIMAL)
        Optimisation.Result optimal = Optimisation.Result.of(Optimisation.State.OPTIMAL, 0.0);
        model.setKnownSolution(optimal);
        assertSame(optimal, model.getKnownSolution());
    }

    @Test(expected = ProgrammingError.class)
    public void testSetKnownSolutionRejectsNonOptimal() {
        Optimisation.Result notOptimal = Optimisation.Result.of(Optimisation.State.INFEASIBLE, 0.0);
        model.setKnownSolution(notOptimal);
    }

    @Test
    public void testRelaxSoftFlagLeavesIntegerFlagIntactButMarksRelaxed() {
        Variable iv = model.addVariable("intVar").integer();
        assertTrue(iv.isInteger());
        model.relax(true);
        // integer flag stays, but model reports relaxed
        assertTrue(iv.isInteger());
        assertTrue(model.isRelaxed());
    }

    @Test
    public void testRemoveExpressionDeletesIt() {
        model.addExpression("toRemove");
        assertNotNull(model.getExpression("toRemove"));
        model.removeExpression("toRemove");
        assertNull(model.getExpression("toRemove"));
    }

    @Test
    public void testReduceInvokesPresolverUtility() {
        // Reduce on an empty model should be a no‑op but must not fail
        model.reduce();
        assertEquals(0, model.countExpressions());
    }

    @Test
    public void testSnapshotCreatesRelaxedShallowCopy() {
        ExpressionsBasedModel snap = model.snapshot();
        assertTrue(snap.isShallowCopy());
        assertTrue(snap.isRelaxed());
    }

    @Test
    public void testDisposeClearsAllData() {
        model.addVariable("v");
        model.addExpression("e");
        model.dispose();
        assertEquals(0, model.countVariables());
        assertEquals(0, model.countExpressions());
    }
}
